EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set true only for local testing without Stripe (requires Edge secret ALLOW_DEMO_BILLING=true)
# EXPO_PUBLIC_ALLOW_DEMO_BILLING=true

# LiveKit (Supabase Edge Function secrets):
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...

# Stripe payment gateway (Supabase Edge Function secrets):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_QUARTERLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# CHECKOUT_SUCCESS_URL=lingowave://subscription?status=success
# CHECKOUT_CANCEL_URL=lingowave://subscription?status=cancel
# ALLOW_DEMO_BILLING=true

# AI translator (Supabase Edge Function secrets) — optional upgrades over MyMemory fallback:
# OPENAI_API_KEY=sk-...
# DEEPL_API_KEY=...
# TRANSLATE_PROVIDER=auto
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Optional: schedule daily-predictions with header x-cron-secret
# CRON_SECRET=long-random-string
