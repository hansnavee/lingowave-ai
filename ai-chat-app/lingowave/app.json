{
  "expo": {
    "name": "LingoWave",
    "slug": "lingowave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/lingowave-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/branding/lingowave-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5F2"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CCFBF1",
        "foregroundImage": "./assets/branding/lingowave-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/lingowave-logo.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
